# ============================================================
# 兰亭（Folio）· 环境配置模板
# 用法：复制本文件为 .env，按需填写。全部留空也能跑（L0 能力等级）。
# 能力等级与每个槽位的取舍见 docs/能力配置引导_v1_2026-08-15.md
# ============================================================

# ---------- L1 语义召回（可选，推荐）----------
# 配下面任一，召回从「字面匹配」升级为「语义匹配」。
# 不配：自动降级为纯 BM25，引擎照常运行（小知识库够用）。
# 智谱 GLM（embedding + chat 兜底）：https://open.bigmodel.cn
ZHIPU_API_KEY=
# 硅基流动（embedding + rerank）：https://siliconflow.cn
SILICONFLOW_API_KEY=

# ---------- L1+ 精排（可选）----------
# 用上面的 SILICONFLOW_API_KEY 即可，无额外 key。
# 不配：返回 RRF 融合原序，多数场景够用；知识库大了再配。

# ---------- L2 读图（可选）----------
# 只在没有原生读图能力的宿主（独立 CLI 场景）才需要。
# DSH 下用宿主原生 read_image / image_ocr，此处留空即可。
# 视觉理解 provider（内置默认 MiniMax，可替换为任意 OpenAI 兼容视觉端点）：
#   https://platform.minimaxi.com
# 其他厂商：vision-describe --provider 指定（OpenAI 兼容协议，需在 src/_cloud_llm.py PROVIDERS 登记）
MINIMAX_API_KEY=

# ---------- L2 搜索（可选）----------
# 独立 CLI 场景的联网搜索；DSH 下用宿主原生 web_search，此处留空即可。
# Tavily（第一引擎）：https://tavily.com
TAVILY_API_KEY=
# 火山引擎（第二引擎，与上二选一）
ASK_ECHO_SEARCH_INFINITY_API_KEY=

# ---------- L3 独立审查 LLM（可选）----------
# review 命令的独立审查会话；DSH 下可用子代理替代（零 key）。
# 以下任一即可：
DEEPSEEK_API_KEY=
MIMO_API_KEY=
